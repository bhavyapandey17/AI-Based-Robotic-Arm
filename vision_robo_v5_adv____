      <button class="sendbtn rd" style="flex:1" onclick="closeHomeModal()">✕ Cancel</button>
    </div>
  </div>
</div>

<script>
// ══ STATE ══
// Mirrors Python _DEFAULT_HOME — used as fallback if server unreachable
const _DEFAULT_HOME={base:90,shoulder:90,elbow:45,gripper:30};
const SL={base:'slBase',shoulder:'slShoulder',elbow:'slElbow',gripper:'slGripper'};
const VL={base:'vBase', shoulder:'vShoulder', elbow:'vElbow', gripper:'vGripper'};
let sv={base:90,shoulder:90,elbow:45,gripper:30};
let edgeOn=false, autoOn=false, isRecording=false;
let sendT=null, modalAction=null;
let currentTab='rec';

// ══ TOAST ══
function toast(msg,type='info'){
  const e=document.getElementById('toast');
  e.textContent=msg; e.className='toast show '+type;
  clearTimeout(e._t); e._t=setTimeout(()=>e.classList.remove('show'),2600);
}

// ══ TABS ══
function switchTab(id){
  currentTab=id;
  document.querySelectorAll('.tab-btn').forEach((b,i)=>{
    const tabs=['rec','pr','tr'];
    b.className='tab-btn'+(tabs[i]===id?' active':'');
  });
  document.querySelectorAll('.tab-pane').forEach(p=>p.classList.remove('active'));
  document.getElementById('tab-'+id).classList.add('active');
  if(id==='pr') loadPickRules();
  if(id==='tr') loadObjects();
}

// ══ SERVO ══
function si(axis, val){
  sv[axis] = +val;
  document.getElementById(VL[axis]).textContent = val + '°';
  clearTimeout(sendT);
  // Send ONLY the moved axis so esp_move_seq on the server can correctly
  // decide whether a gripper delay is needed (arm axes present → wait, gripper-only → instant)
  sendT = setTimeout(() => sendAxis(axis, sv[axis]), 130);
}
function sendAxis(axis, val){
  const payload = {};
  payload[axis] = val;
  fetch('/api/servo',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
  .then(r=>r.json())
  .catch(()=>toast('ESP32 offline','err'));
}
function sendServos(){
  // "Send positions" button — sends all axes together;
  // server applies gripper delay after arm axes settle
  fetch('/api/servo',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(sv)})
  .then(r=>r.json()).then(d=>toast('Positions sent (grip delay: '+d.gripper_delay+'s)','ok'))
  .catch(()=>toast('ESP32 offline','err'));
}
function callHome(){
  fetch('/api/home',{method:'POST'}).then(r=>r.json()).then(d=>{
    const pos = d.home_position || {base:90,shoulder:90,elbow:45,gripper:30};
    Object.entries(pos).forEach(([a,v])=>{
      sv[a]=v;
      if(SL[a]){ document.getElementById(SL[a]).value=v; document.getElementById(VL[a]).textContent=v+'°'; }
    });
    toast('Homed','ok');
  }).catch(()=>toast('ESP32 offline','err'));
}
function callPreset(n){
  const P={
    pick:{base:90,shoulder:110,elbow:80,gripper:10},
    place:{base:60,shoulder:105,elbow:75,gripper:30},
  };
  const p=P[n]||{}; Object.entries(p).forEach(([k,v])=>{
    sv[k]=v; document.getElementById(SL[k]).value=v;
    document.getElementById(VL[k]).textContent=v+'°';
  });
  fetch('/api/preset',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:n})})
  .then(()=>toast(n[0].toUpperCase()+n.slice(1)+' preset','info'))
  .catch(()=>toast('ESP32 offline','err'));
}

// ══ VISION TOGGLES ══
function toggleEdge(){
  edgeOn=!edgeOn;
  fetch('/api/toggle_edge',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:edgeOn})});
  document.getElementById('btnEdge').className='itb'+(edgeOn?' on':'');
  const c=document.getElementById('chipEdge');
  c.className='chip'+(edgeOn?' on':'');
  c.innerHTML='<span class="dot"></span>Edge'+(edgeOn?' on':'');
}
function toggleAuto(){
  autoOn=!autoOn;
  fetch('/api/toggle_auto',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:autoOn})});
  document.getElementById('btnAuto').className='itb gn'+(autoOn?' on':'');
  const c=document.getElementById('chipAuto');
  c.className='chip'+(autoOn?' on':'');
  c.innerHTML='<span class="dot"></span>'+(autoOn?'Auto on':'Manual');
  toast(autoOn?'Auto mode enabled':'Manual mode','info');
}

// ══ STATUS POLL ══
function refreshStatus(){
  fetch('/api/status').then(r=>r.json()).then(d=>{
    const conn=document.getElementById('chipConn');
    conn.className='chip live'; conn.innerHTML='<span class="dot"></span>Online';
    document.getElementById('grDelay').textContent='Grip delay: '+d.gripper_delay+'s';
    const pb=d.playback||{};
    const cpb=document.getElementById('chipPb');
    if(pb.running){
      cpb.className='chip play';
      cpb.innerHTML='<span class="dot"></span>Playing: '+pb.name+' '+pb.step+'/'+pb.total;
      document.getElementById('hudPb').textContent='▶ '+pb.name+' step '+pb.step+'/'+pb.total;
    } else {
      cpb.className='chip'; cpb.innerHTML='<span class="dot"></span>Idle';
      document.getElementById('hudPb').textContent='';
    }
    document.getElementById('hudTime').textContent=new Date().toLocaleTimeString();
    renderDets(d.detections||[]);
    // keep rec session badge
    if(d.recording && d.recording.active && !isRecording){
      // sync state
    }
  }).catch(()=>{
    const conn=document.getElementById('chipConn');
    conn.className='chip warn'; conn.innerHTML='<span class="dot"></span>Offline';
  });
}
setInterval(refreshStatus,1200);

// ══ DETECTIONS ══
function renderDets(dets){
  const el=document.getElementById('detList');
  document.getElementById('detBadge').textContent=dets.length? dets.length+' objects':'–';
  if(!dets.length){el.innerHTML='<div class="det-empty">No objects in frame</div>';return;}
  el.innerHTML=dets.map(d=>`
    <div class="det-item">
      <div class="det-pip" style="background:var(--cy)"></div>
      <div class="det-body">
        <div class="det-name">${d.name}</div>
        <div class="det-meta">${d.color} · ${d.shape}</div>
      </div>
      <span class="det-pct" style="color:var(--gn)">${Math.round(d.confidence)}%</span>
    </div>`).join('');
}

// ══ RECORDING ══
function toggleRecord(){
  if(!isRecording) startRecording();
  else finishRecordingPrompt();
}
function startRecording(){
  fetch('/api/record/start',{method:'POST'}).then(()=>{
    isRecording=true;
    document.getElementById('btnRecord').className='itb rd on';
    document.getElementById('btnRecord').textContent='⏺ Recording…';
    document.getElementById('recSession').style.display='block';
    document.getElementById('chipConn'); // no change needed
    // switch to rec tab
    switchTab('rec');
    updateRecSteps([]);
    toast('Recording started — move servos then press Capture','warn');
    // ensure chip
    const c=document.getElementById('chipConn');
  }).catch(()=>toast('Error','err'));
}
function captureStep(){
  const hold=parseFloat(document.getElementById('recHold').value)||0.5;
  fetch('/api/record/capture',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({positions:{...sv},hold})})
  .then(r=>r.json()).then(d=>{
    toast('Step '+d.step+' captured: B'+d.data.base+'° S'+d.data.shoulder+'° E'+d.data.elbow+'° G'+d.data.gripper+'°','ok');
    loadRecSteps();
  }).catch(()=>toast('Capture error','err'));
}
function discardLast(){
  fetch('/api/record/discard_last',{method:'POST'}).then(r=>r.json()).then(d=>{
    toast('Last step undone ('+d.remaining+' remaining)','info');
    loadRecSteps();
  });
}
function loadRecSteps(){
  // get current session steps via status
  fetch('/api/status').then(r=>r.json()).then(d=>{
    const n=d.recording?d.recording.steps:0;
    document.getElementById('recStepCount').textContent=n;
    // rebuild preview from last captured (we don't have full list here; just count)
  });
}
function updateRecSteps(steps){
  document.getElementById('recStepCount').textContent=steps.length;
  const pv=document.getElementById('recStepsPreview');
  pv.innerHTML=steps.map((s,i)=>`
    <div class="rec-step-row">
      <span>Step ${i+1}: B${s.base}° S${s.shoulder}° E${s.elbow}° G${s.gripper}°</span>
      <span>hold ${s.hold}s</span>
    </div>`).join('');
}
function finishRecordingPrompt(){
  showModal('Save recording','<div class="modal-row"><span class="modal-lbl">Name</span><input class="modal-inp" id="mRecName" value="Recording '+(Date.now()%1000)+'"></div>',
    ()=>{
      const name=document.getElementById('mRecName').value.trim()||'Recording';
      fetch('/api/record/finish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name})})
      .then(r=>r.json()).then(d=>{
        toast('Saved: '+d.name+' ('+d.steps+' steps)','ok');
        stopRecordUI(); loadRecordings();
      }).catch(()=>toast('Save error','err'));
    });
}
function finishRecording(){finishRecordingPrompt();}
function cancelRecording(){
  fetch('/api/record/cancel',{method:'POST'}).then(()=>{
    stopRecordUI(); toast('Recording cancelled','info');
  });
}
function stopRecordUI(){
  isRecording=false;
  document.getElementById('btnRecord').className='itb rd';
  document.getElementById('btnRecord').textContent='⏺ Record';
  document.getElementById('recSession').style.display='none';
}

// ══ RECORDINGS LIST ══
let _playingId=null;
function loadRecordings(){
  fetch('/api/recordings/list').then(r=>r.json()).then(data=>{
    const el=document.getElementById('recList');
    if(!data.length){el.innerHTML='<div class="det-empty">No recordings — press ⏺ Record to create one</div>';return;}
    el.innerHTML=data.map(r=>`
      <div class="rec-item${r.id===_playingId?' playing':''}" id="ri_${r.id}">
        <div class="rec-ico">▶</div>
        <div class="rec-info">
          <div class="rec-name">${esc(r.name)}</div>
          <div class="rec-meta">${r.steps} steps · ${r.created||''}</div>
        </div>
        <div class="rec-acts">
          <button class="rab rab-pl" onclick="playRec('${r.id}','${esc(r.name)}')">▶</button>
          <button class="rab rab-ed" onclick="renameRec('${r.id}','${esc(r.name)}')">✎</button>
          <button class="rab rab-rm" onclick="deleteRec('${r.id}')">✕</button>
        </div>
      </div>`).join('');
  });
}
function playRec(id,name){
  if(_playingId===id){
    fetch('/api/recordings/stop',{method:'POST'}).then(()=>{_playingId=null;loadRecordings();toast('Stopped','info')});
    return;
  }
  fetch('/api/recordings/play',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id})})
  .then(r=>r.json()).then(d=>{
    if(d.status==='playing'){_playingId=id;loadRecordings();toast('▶ Playing: '+name,'info');}
    else toast('Cannot play — already running or not found','err');
  });
}
function renameRec(id,currentName){
  showModal('Rename recording',
    `<div class="modal-row"><span class="modal-lbl">New name</span><input class="modal-inp" id="mRename" value="${esc(currentName)}"></div>`,
    ()=>{
      const name=document.getElementById('mRename').value.trim();
      if(!name) return;
      fetch('/api/recordings/rename',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,name})})
      .then(r=>r.json()).then(()=>{toast('Renamed','ok');loadRecordings();})
      .catch(()=>toast('Error','err'));
    });
}
function deleteRec(id){
  if(!confirm('Delete this recording?')) return;
  fetch('/api/recordings/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id})})
  .then(r=>r.json()).then(d=>{toast('Deleted: '+d.name,'info');loadRecordings();})
  .catch(()=>toast('Error','err'));
}

// ══ PICK RULES ══
let _editingPr=null;
function loadPickRules(){
  fetch('/api/pick_rules').then(r=>r.json()).then(data=>{
    const el=document.getElementById('prList');
    if(!data.length){el.innerHTML='<div class="det-empty">No pick rules configured</div>';return;}
    el.innerHTML=data.map(r=>`
      <div class="pr-item">
        <div class="pr-head">
          <span class="pr-name">◎ ${esc(r.object_name)}</span>
          <div class="pr-acts">
            <button class="rab rab-pl" onclick="runPr('${esc(r.object_name)}')">▶ Run</button>
            <button class="rab rab-ed" onclick="openPrModal('${esc(r.object_name)}')">Edit</button>
            <button class="rab rab-rm" onclick="deletePr('${esc(r.object_name)}')">✕</button>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px 10px">
          ${prFieldRow('Approach base',r.approach_base+'°')}
          ${prFieldRow('Drop base',r.drop_base+'°')}
          ${prFieldRow('Grip open',r.grip_open+'°')}
          ${prFieldRow('Grip close',r.grip_close+'°')}
          ${prFieldRow('Drop hold',r.drop_hold+'s')}
        </div>
      </div>`).join('');
  });
}
function prFieldRow(label,val){
  return`<div style="font-family:var(--fm);font-size:9px;color:var(--tx3)">${label}: <span style="color:var(--tx1)">${val}</span></div>`;
}
function openPrModal(objectName){
  // get existing rule if editing
  fetch('/api/pick_rules').then(r=>r.json()).then(rules=>{
    const existing=rules.find(r=>r.object_name===objectName)||{};
    fetch('/api/objects').then(r=>r.json()).then(objs=>{
      const objOpts=objs.map(o=>`<option value="${esc(o.name)}"${o.name===objectName?'selected':''}>${esc(o.name)}</option>`).join('');
      const f=(k,def)=>existing[k]!==undefined?existing[k]:def;
      const body=`
        <div class="modal-row"><span class="modal-lbl">Object</span>
          <select class="modal-inp" id="prObj">${objOpts}</select></div>
        <div style="font-family:var(--fm);font-size:9px;color:var(--tx3);margin-bottom:8px;line-height:1.7">
          Approach → open gripper → lower → grip → lift → rotate to drop base → release
        </div>
        ${mRow('Approach base (°)','prApBase',f('approach_base',90))}
        ${mRow('Approach shoulder (°)','prApSh',f('approach_shoulder',110))}
        ${mRow('Grip open (°)','prGripO',f('grip_open',30))}
        ${mRow('Grip close (°)','prGripC',f('grip_close',0))}
        ${mRow('Lift shoulder (°)','prLiftSh',f('lift_shoulder',90))}
        ${mRow('Drop base angle (°)','prDropBase',f('drop_base',0))}
        ${mRow('Drop shoulder (°)','prDropSh',f('drop_shoulder',110))}
        ${mRow('Drop hold (s)','prDropHold',f('drop_hold',0.3))}
      `;
      showModal(objectName?'Edit pick rule':'New pick rule', body, ()=>{
        const rule={
          object_name:       document.getElementById('prObj').value,
          approach_base:     +document.getElementById('prApBase').value,
          approach_shoulder: +document.getElementById('prApSh').value,
          grip_open:         +document.getElementById('prGripO').value,
          grip_close:        +document.getElementById('prGripC').value,
          lift_shoulder:     +document.getElementById('prLiftSh').value,
          drop_base:         +document.getElementById('prDropBase').value,
          drop_shoulder:     +document.getElementById('prDropSh').value,
          drop_hold:         +document.getElementById('prDropHold').value,
        };
        fetch('/api/pick_rules/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(rule)})
        .then(r=>r.json()).then(d=>{toast('Pick rule saved for '+d.rule.object_name,'ok');loadPickRules();})
        .catch(()=>toast('Error','err'));
      });
    });
  });
}
function mRow(label,id,def){
  return`<div class="modal-row"><span class="modal-lbl">${label}</span><input class="modal-inp" id="${id}" type="number" value="${def}"></div>`;
}
function runPr(name){
  fetch('/api/pick_rules/run',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({object_name:name})})
  .then(()=>toast('Running pick rule: '+name,'info'))
  .catch(()=>toast('Error','err'));
}
function deletePr(name){
  if(!confirm('Delete pick rule for "'+name+'"?')) return;
  fetch('/api/pick_rules/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({object_name:name})})
  .then(r=>r.json()).then(()=>{toast('Deleted rule for '+name,'info');loadPickRules();})
  .catch(()=>toast('Error','err'));
}

// ══ TRAINING ══
function hN(h){const d=h*2;if(d<15||d>=345)return'Red';if(d<35)return'Orange';if(d<75)return'Yellow';if(d<160)return'Green';if(d<200)return'Cyan';if(d<260)return'Blue';if(d<290)return'Purple';if(d<330)return'Pink';return'Red';}
function hsvRgb(h,s,v){h=h/179*360;s/=255;v/=255;const c=v*s,x=c*(1-Math.abs(h/60%2-1)),m=v-c;let r=0,g=0,b=0;if(h<60){r=c;g=x}else if(h<120){r=x;g=c}else if(h<180){g=c;b=x}else if(h<240){g=x;b=c}else if(h<300){r=x;b=c}else{r=c;b=x}return`rgb(${Math.round((r+m)*255)},${Math.round((g+m)*255)},${Math.round((b+m)*255)})`;}
function uHSV(){
  const hL=+document.getElementById('hLo').value,hH=+document.getElementById('hHi').value;
  const sL=+document.getElementById('sLo').value,sH=+document.getElementById('sHi').value;
  const vL=+document.getElementById('vLo').value,vH=+document.getElementById('vHi').value;
  [['nhLo',hL],['nhHi',hH],['nsLo',sL],['nsShi',sH],['nvLo',vL],['nvHi',vH]]
    .forEach(([id,v])=>document.getElementById(id).textContent=v);
  document.getElementById('cprev').style.background=
    `linear-gradient(90deg,${hsvRgb(hL,(sL+sH)/2,(vL+vH)/2)},${hsvRgb(hH,(sL+sH)/2,(vL+vH)/2)})`;
  document.getElementById('cname').textContent=hN((hL+hH)/2);
}
uHSV();
function trainObj(){
  const name=document.getElementById('tName').value.trim();
  if(!name){toast('Enter a name first','err');return;}
  const lo=[+document.getElementById('hLo').value,+document.getElementById('sLo').value,+document.getElementById('vLo').value];
  const hi=[+document.getElementById('hHi').value,+document.getElementById('sHi').value,+document.getElementById('vHi').value];
  fetch('/api/train',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({name,shape:document.getElementById('tShape').value,color_lower:lo,color_upper:hi})})
  .then(r=>r.json()).then(d=>{
    toast('Trained: '+d.object.name+' ('+d.object.color+' '+d.object.shape+')','ok');
    document.getElementById('tName').value='';
    loadObjects();
  }).catch(()=>toast('Training error','err'));
}
function loadObjects(){
  fetch('/api/objects').then(r=>r.json()).then(data=>{
    const el=document.getElementById('objList');
    if(!data.length){el.innerHTML='<div class="det-empty">No objects trained</div>';return;}
    el.innerHTML=data.map((obj,i)=>{
      const mH=(obj.color_lower[0]+obj.color_upper[0])/2;
      const mS=(obj.color_lower[1]+obj.color_upper[1])/2;
      const mV=(obj.color_lower[2]+obj.color_upper[2])/2;
      const dot=hsvRgb(mH,mS,mV);
      return`<div class="obj-item">
        <div class="obj-dot" style="background:${dot}"></div>
        <div class="obj-info">
          <div class="obj-name">${esc(obj.name)}</div>
          <div class="obj-meta">${obj.color} · ${obj.shape} · H ${obj.color_lower[0]}–${obj.color_upper[0]}</div>
        </div>
        <div class="obj-acts">
          <button class="rab rab-ed" onclick="openPrModal('${esc(obj.name)}')" title="Create pick rule">⊕ Rule</button>
          <button class="rab rab-rm" onclick="delObj(${i})">✕</button>
        </div>
      </div>`;
    }).join('');
  });
}
function delObj(idx){
  if(!confirm('Delete this object?')) return;
  fetch('/api/delete_object',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({index:idx})})
  .then(r=>r.json()).then(d=>{toast('Deleted: '+d.name,'info');loadObjects();})
  .catch(()=>toast('Error','err'));
}

// ══ MODAL ══
function showModal(title, body, okFn){
  document.getElementById('modalTitle').textContent=title;
  document.getElementById('modalBody').innerHTML=body;
  modalAction=okFn;
  document.getElementById('modalBg').style.display='flex';
}
function closeModal(e){
