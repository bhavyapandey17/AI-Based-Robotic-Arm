@app.route("/api/record/start", methods=["POST"])
def api_record_start():
    record_session.update(active=True, steps=[], pending=None)
    return jsonify({"status":"recording_started"})

@app.route("/api/record/capture", methods=["POST"])
def api_record_capture():
    """Capture current servo positions as a new step. Body: {positions:{...}, hold:0.5}"""
    if not record_session["active"]:
        return jsonify({"error":"no active recording"}),400
    d    = request.json or {}
    pos  = d.get("positions", {})
    hold = float(d.get("hold", 0.5))
    step = {k:int(v) for k,v in pos.items() if k in ("base","shoulder","elbow","gripper") and v is not None}
    step["hold"] = hold
    record_session["steps"].append(step)
    return jsonify({"status":"captured","step":len(record_session["steps"]),"data":step})

@app.route("/api/record/discard_last", methods=["POST"])
def api_record_discard():
    if record_session["steps"]:
        record_session["steps"].pop()
    return jsonify({"status":"ok","remaining":len(record_session["steps"])})

@app.route("/api/record/finish", methods=["POST"])
def api_record_finish():
    """Finish and save recording. Body: {name}"""
    d    = request.json or {}
    name = d.get("name","").strip() or f"Recording {len(recordings)+1}"
    if not record_session["steps"]:
        return jsonify({"error":"no steps recorded"}),400
    rec_id = f"rec_{int(time.time()*1000)}"
    rec = {"id":rec_id,"name":name,"steps":list(record_session["steps"]),
           "created":time.strftime("%Y-%m-%d %H:%M:%S")}
    recordings.append(rec)
    _save(RECORDINGS_FILE, recordings)
    record_session.update(active=False, steps=[], pending=None)
    return jsonify({"status":"saved","id":rec_id,"name":name,"steps":len(rec["steps"])})

@app.route("/api/record/cancel", methods=["POST"])
def api_record_cancel():
    record_session.update(active=False, steps=[], pending=None)
    return jsonify({"status":"cancelled"})

