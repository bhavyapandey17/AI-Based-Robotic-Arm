// ══ ENHANCED refreshStatus ══
// Override the existing refreshStatus to add auto_action,
// no_rule_prompt, home_position, and beep triggering
const _prevRefresh = refreshStatus;
let _lastAction = 'IDLE';
refreshStatus = function(){
  fetch('/api/status').then(r=>r.json()).then(d=>{
    // connection
    document.getElementById('chipConn').className='chip live';
    document.getElementById('chipConn').innerHTML='<span class="dot"></span>Online';
    // grip delay
    if(d.gripper_delay!==undefined)
      document.getElementById('grDelay').textContent='Grip delay: '+d.gripper_delay+'s';
    // auto action → beep on state transition
    const action = d.auto_action || 'IDLE';
    if(action !== _lastAction) {
      if(action.startsWith('PICK') || action.startsWith('RULE'))
        _beepBrowser(1, 880, 120);    // 1 beep — accepted
      else if(action.startsWith('REJECT'))
        _beepBrowser(3, 440, 100);    // 3 beeps — wrong
      _lastAction = action;
    }
    // action chip
    const ca = document.getElementById('chipPb');
    if(d.playback && d.playback.running) {
      ca.className='chip play';
      ca.innerHTML='<span class="dot"></span>▶ '+d.playback.name+' '+d.playback.step+'/'+d.playback.total;
      document.getElementById('hudPb').textContent='▶ '+d.playback.name+' '+d.playback.step+'/'+d.playback.total;
    } else if(action!=='IDLE'&&action!=='MONITORING') {
      ca.className='chip play';
      ca.innerHTML='<span class="dot"></span>'+action;
      document.getElementById('hudPb').textContent=action;
    } else {
      ca.className='chip'; ca.innerHTML='<span class="dot"></span>Idle';
      document.getElementById('hudPb').textContent='';
    }
    // no-rule banner
    const noRule = d.no_rule_prompt||[];
    const banner = document.getElementById('noRuleBanner');
    if(noRule.length && !_noRuleTarget) {
      _noRuleTarget = noRule[0];
      document.getElementById('noRuleMsg').textContent =
        'Auto: "'+_noRuleTarget+'" detected but has no recording. Create a recording named "'+_noRuleTarget+'" to enable auto-pick.';
      banner.style.display='block';
    } else if(!noRule.length) {
      banner.style.display='none';
    }
    // detections with accept/reject colouring
    const det=d.detections||[];
    document.getElementById('detBadge').textContent=det.length?det.length+' objects':'–';
    const dl=document.getElementById('detList');
    if(!det.length){dl.innerHTML='<div class="det-empty">No objects in frame</div>';return;}
    dl.innerHTML=det.map(d=>{
      const col=d.accepted?'var(--gn)':'var(--rd)';
      const tag=d.accepted?'ACCEPT':'REJECT';
      return`<div class="det-item">
        <div class="det-pip" style="background:${col}"></div>
        <div class="det-body">
          <div class="det-name" style="color:${col}">${esc(d.name)}</div>
          <div class="det-meta">${d.color} · ${d.shape}</div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:2px">
          <span style="font-family:var(--fm);font-size:9px;padding:1px 5px;border-radius:3px;
            border:1px solid ${col};color:${col}">${tag}</span>
          <span class="det-pct" style="color:${col}">${Math.round(d.confidence)}%</span>
        </div>
      </div>`;
    }).join('');
    document.getElementById('hudTime').textContent=new Date().toLocaleTimeString();
  }).catch(()=>{
    document.getElementById('chipConn').className='chip warn';
    document.getElementById('chipConn').innerHTML='<span class="dot"></span>Offline';
  });
};

