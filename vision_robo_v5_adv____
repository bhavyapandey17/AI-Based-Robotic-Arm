</div>

<div class="toast" id="toast"></div>

<!-- SET HOME MODAL -->
<div id="homeModalBg" style="display:none;position:fixed;inset:0;background:rgba(9,9,15,.85);
  z-index:200;align-items:center;justify-content:center">
