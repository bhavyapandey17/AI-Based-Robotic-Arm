.sv-send{width:calc(100% - 20px);margin:6px 10px 0;font-family:var(--fm);font-size:10px;
  font-weight:500;letter-spacing:.08em;padding:7px;border-radius:var(--r2);
  border:1px solid var(--cy2);background:var(--cy-a);color:var(--cy);cursor:pointer;transition:.18s}
.sv-send:hover{background:rgba(0,212,255,.2)}
.preset-sec{padding:6px 10px;border-top:1px solid var(--rim);flex-shrink:0}
.ps-lbl{font-family:var(--fm);font-size:9px;color:var(--tx3);text-transform:uppercase;
  letter-spacing:.1em;margin-bottom:4px}
.ps-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px}
.pb{font-family:var(--fm);font-size:10px;font-weight:500;letter-spacing:.06em;
  padding:5px 4px;border-radius:var(--r2);border:1px solid var(--rim2);
  background:var(--ink2);color:var(--tx2);cursor:pointer;transition:.18s;text-align:center;text-transform:uppercase}
.pb:hover{background:var(--ink3);border-color:var(--rim3);color:var(--tx1)}
.pb.full{grid-column:span 2}
.pb.home{border-color:rgba(155,114,255,.4);color:var(--pu)}
.pb.home:hover{background:var(--pu-a)}

/* ── RIGHT COL ── */
.col-rt{display:grid;grid-template-rows:200px 1fr;gap:var(--gap);min-height:0;overflow:hidden}

/* DETECTION */
.det-item{display:flex;align-items:center;gap:7px;padding:6px 9px;border-radius:var(--r2);
  border:1px solid var(--rim);background:var(--ink2);margin-bottom:3px;animation:pop .18s}
.det-item:hover{border-color:var(--rim2);background:var(--ink3)}
.det-pip{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.det-body{flex:1;min-width:0}
.det-name{font-weight:500;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.det-meta{font-family:var(--fm);font-size:9px;color:var(--tx2)}
.det-pct{font-family:var(--fm);font-size:13px;font-weight:500;min-width:30px;text-align:right}
.det-empty{color:var(--tx3);font-size:11px;padding:14px;text-align:center;font-family:var(--fm)}

/* ── TABS ── */
.tabs{flex:1;display:flex;flex-direction:column;overflow:hidden;min-height:0}
.tab-bar{display:flex;border-bottom:1px solid var(--rim);flex-shrink:0;padding:0 4px}
.tab-btn{font-family:var(--fm);font-size:10px;font-weight:500;letter-spacing:.07em;
  padding:7px 10px;border:none;background:transparent;color:var(--tx2);
  cursor:pointer;border-bottom:2px solid transparent;transition:.18s;text-transform:uppercase;white-space:nowrap}
.tab-btn:hover{color:var(--tx1)}
.tab-btn.active{color:var(--cy);border-bottom-color:var(--cy)}
.tab-pane{display:none;flex:1;overflow:hidden;flex-direction:column;min-height:0}
.tab-pane.active{display:flex}

/* RECORDING TAB */
.rec-list{padding:6px}
.rec-item{display:flex;align-items:center;gap:6px;background:var(--ink2);
  border:1px solid var(--rim);border-radius:var(--r2);padding:6px 8px;margin-bottom:3px;
  cursor:pointer;transition:.18s}
.rec-item:hover{border-color:var(--cy2);background:var(--ink3)}
.rec-item.playing{border-color:var(--or);background:var(--or-a);animation:blink 1s step-end infinite}
.rec-ico{width:28px;height:28px;border-radius:5px;background:var(--cy-a);
  display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0;color:var(--cy)}
.rec-info{flex:1;min-width:0}
.rec-name{font-weight:500;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rec-meta{font-family:var(--fm);font-size:9px;color:var(--tx3)}
.rec-acts{display:flex;gap:3px;flex-shrink:0}
.rab{font-family:var(--fm);font-size:9px;font-weight:500;padding:3px 6px;border-radius:3px;
  border:1px solid;cursor:pointer;background:transparent;transition:.15s}
.rab-pl{border-color:var(--gn2);color:var(--gn)}  .rab-pl:hover{background:var(--gn-a)}
.rab-ed{border-color:var(--cy2);color:var(--cy)}  .rab-ed:hover{background:var(--cy-a)}
.rab-rm{border-color:var(--rd2);color:var(--rd)}  .rab-rm:hover{background:var(--rd-a)}

/* Recording session panel */
.rec-session{background:var(--ink2);border:1px solid var(--rd2);border-radius:var(--r2);
  padding:8px 10px;margin:6px;animation:borderPulse 1.5s ease-in-out infinite}
@keyframes borderPulse{0%,100%{border-color:var(--rd2)}50%{border-color:var(--rd)}}
.rec-sess-hdr{font-family:var(--fm);font-size:10px;font-weight:500;color:var(--rd);
  letter-spacing:.08em;margin-bottom:6px;display:flex;align-items:center;justify-content:space-between}
.rec-steps-preview{display:flex;flex-direction:column;gap:2px;max-height:80px;overflow-y:auto;margin-bottom:6px}
.rec-step-row{font-family:var(--fm);font-size:9px;color:var(--tx2);padding:2px 4px;
  background:var(--ink3);border-radius:3px;display:flex;justify-content:space-between}
.rec-sess-btns{display:flex;gap:4px;flex-wrap:wrap}

/* PICK RULES TAB */
.pr-item{background:var(--ink2);border:1px solid var(--rim);border-radius:var(--r2);
  padding:7px 9px;margin-bottom:4px}
.pr-item:hover{border-color:var(--rim2)}
.pr-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:5px}
.pr-name{font-weight:500;font-size:12px;color:var(--gn)}
.pr-acts{display:flex;gap:3px}
.pr-field{display:flex;align-items:center;gap:5px;margin-bottom:3px}
.pr-lbl{font-family:var(--fm);font-size:9px;color:var(--tx3);min-width:90px;text-transform:uppercase}
.pr-inp{flex:1;background:var(--ink3);border:1px solid var(--rim2);border-radius:3px;
  padding:3px 6px;color:var(--tx0);font-family:var(--fm);font-size:11px;outline:none}
.pr-inp:focus{border-color:var(--cy2)}

/* TRAINING TAB */
.tf-row{display:flex;align-items:center;gap:5px;margin-bottom:5px}
.tf-lbl{font-family:var(--fm);font-size:9px;color:var(--tx2);min-width:42px;text-transform:uppercase;letter-spacing:.06em}
.tf-inp{flex:1;background:var(--ink3);border:1px solid var(--rim2);border-radius:var(--r2);
  padding:4px 7px;color:var(--tx0);font-family:var(--fm);font-size:11px;outline:none}
.tf-inp:focus{border-color:var(--cy2)}
select.tf-inp option{background:var(--ink2)}
.hsvwrap{background:var(--ink2);border:1px solid var(--rim);border-radius:var(--r2);
  padding:7px;margin-bottom:5px}
.hsv-lbl{font-family:var(--fm);font-size:9px;color:var(--tx3);text-transform:uppercase;
  letter-spacing:.08em;margin-bottom:5px}
.hrow{display:flex;align-items:center;gap:5px;margin-bottom:3px}
.hl{font-family:var(--fm);font-size:10px;font-weight:500;min-width:12px;text-align:center}
.hsl{flex:1;appearance:none;height:3px;border-radius:2px;outline:none;cursor:pointer;background:var(--ink4)}
.hsl::-webkit-slider-thumb{appearance:none;width:11px;height:11px;border-radius:50%;cursor:pointer;border:1px solid var(--ink1)}
.hnum{font-family:var(--fm);font-size:9px;color:var(--tx2);min-width:20px;text-align:right}
.cprev{width:100%;height:12px;border-radius:3px;border:1px solid var(--rim);margin:3px 0}
.cname-lbl{font-family:var(--fm);font-size:9px;color:var(--tx2);text-align:center}
.obj-item{display:flex;align-items:center;gap:5px;background:var(--ink2);border:1px solid var(--rim);
  border-radius:var(--r2);padding:5px 7px;margin-bottom:2px}
.obj-item:hover{border-color:var(--rim2)}
.obj-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.obj-info{flex:1;min-width:0}
.obj-name{font-weight:500;font-size:11px}
.obj-meta{font-family:var(--fm);font-size:9px;color:var(--tx3)}
.obj-acts{display:flex;gap:2px;flex-shrink:0}

/* SENDBTN */
.sendbtn{width:100%;font-family:var(--fm);font-size:10px;font-weight:500;letter-spacing:.08em;
  padding:7px;border-radius:var(--r2);border:1px solid var(--cy2);background:var(--cy-a);
  color:var(--cy);cursor:pointer;transition:.18s;margin-top:4px}
.sendbtn:hover{background:rgba(0,212,255,.22)}
.sendbtn.gn{border-color:var(--gn2);background:var(--gn-a);color:var(--gn)}
.sendbtn.gn:hover{background:rgba(0,232,136,.2)}
.sendbtn.rd{border-color:var(--rd2);background:var(--rd-a);color:var(--rd)}
.sendbtn.rd:hover{background:rgba(255,60,88,.2)}

/* MODAL overlay */
.modal-bg{position:fixed;inset:0;background:rgba(9,9,15,.82);z-index:200;
  display:flex;align-items:center;justify-content:center;animation:fadeIn .18s}
.modal{background:var(--ink2);border:1px solid var(--rim3);border-radius:var(--r);
  padding:20px;width:360px;max-width:95vw;max-height:90vh;overflow-y:auto}
.modal h3{font-family:var(--fm);font-size:11px;font-weight:500;letter-spacing:.1em;
  color:var(--cy);text-transform:uppercase;margin-bottom:14px}
.modal-row{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.modal-lbl{font-family:var(--fm);font-size:9px;color:var(--tx2);min-width:100px;text-transform:uppercase}
.modal-inp{flex:1;background:var(--ink3);border:1px solid var(--rim2);border-radius:var(--r2);
  padding:5px 8px;color:var(--tx0);font-family:var(--fm);font-size:11px;outline:none}
.modal-inp:focus{border-color:var(--cy2)}
.modal-btns{display:flex;gap:6px;margin-top:14px;justify-content:flex-end}

/* TOAST */
.toast{position:fixed;bottom:12px;right:14px;z-index:999;background:var(--ink3);
  border:1px solid var(--rim3);border-radius:var(--r);padding:7px 13px;
  font-family:var(--fm);font-size:11px;color:var(--tx0);
  box-shadow:0 8px 24px rgba(0,0,0,.4);transform:translateY(12px);opacity:0;transition:.2s;pointer-events:none}
.toast.show{transform:none;opacity:1}
.toast.ok {border-color:var(--gn2);color:var(--gn)}
.toast.err{border-color:var(--rd2);color:var(--rd)}
.toast.info{border-color:var(--cy2);color:var(--cy)}
.toast.warn{border-color:var(--yw2);color:var(--yw)}

@keyframes pop{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
</style>
</head>
<body>
<div class="shell">

<!-- TOPBAR -->
<div class="topbar">
  <div class="logo">⬡ <em>AI Arm</em> Vision System</div>
  <div class="tbr-gap"></div>
  <div class="chip" id="chipEdge"   onclick="toggleEdge()"><span class="dot"></span>Edge</div>
  <div class="chip" id="chipAuto"   onclick="toggleAuto()"><span class="dot"></span>Manual</div>
  <div class="chip" id="chipPb"    ><span class="dot"></span>Idle</div>
  <div class="chip warn" id="chipConn"><span class="dot"></span>Connecting…</div>
</div>

<!-- MAIN -->
<div class="main">

  <!-- COL 1: VIDEO -->
  <div class="panel col-vid">
    <div class="ph">
      <div class="ph-l"><div class="ph-ico ico-cy">●</div>Live stream</div>
      <div class="ph-r">OV3660 · VGA</div>
    </div>
    <div class="vtools">
      <button class="itb"    id="btnEdge" onclick="toggleEdge()">◈ Edge</button>
      <button class="itb gn" id="btnAuto" onclick="toggleAuto()">⬡ Auto</button>
      <div class="vsep"></div>
   
      <button class="itb gn" onclick="callPreset('pick')">↓ Pick</button>
      <button class="itb"    onclick="callPreset('place')">↗ Place</button>
      <button class="itb pu" onclick="callHome()">⌂ Home</button>
      <div class="vsep"></div>
      <button class="itb rd" id="btnRecord" onclick="toggleRecord()">⏺ Record</button>
    </div>
    <div class="vwrap">
      <img id="streamImg" src="/video_feed" alt="Live stream">
      <div id="noRuleBanner" style="display:none;position:absolute;top:8px;left:8px;right:8px;
        background:rgba(15,12,5,.92);border:1px solid var(--yw2);border-radius:6px;
        padding:8px 12px;font-family:var(--fm);font-size:11px;color:var(--yw);
        z-index:10;pointer-events:all">
        <div id="noRuleMsg" style="margin-bottom:6px"></div>
        <div style="display:flex;gap:6px">
          <button class="itb yw" onclick="noRuleAddRule()" style="font-size:10px">+ Add recording</button>
          <button class="itb"    onclick="dismissNoRule()" style="font-size:10px">Dismiss</button>
        </div>
      </div>
      <div class="vhud">
        <div class="vhud-l">
          <div class="vhud-tag">ESP32-CAM · OV3660 · 640×480</div>
          <div class="vhud-pb" id="hudPb"></div>
        </div>
        <div class="vhud-t" id="hudTime">–</div>
      </div>
    </div>
  </div>

  <!-- COL 2: SERVO -->
  <div class="panel col-sv">
    <div class="ph">
      <div class="ph-l"><div class="ph-ico ico-gn">⊕</div>Servo control</div>
      <div class="ph-r" id="grDelay" style="color:var(--yw)">Grip delay: 2.0s</div>
    </div>
    <div style="flex:1;overflow-y:auto;min-height:0">
      <div class="sblk">
        <div class="sh">
          <span class="sl-name" style="color:var(--cy)">⭮ Base</span>
          <span class="sl-val" style="color:var(--cy)" id="vBase">90°</span>
        </div>
        <input type="range" class="srv" id="slBase" min="0" max="180" value="90" style="accent-color:var(--cy)" oninput="si('base',this.value)">
        <div class="slims"><span>0°</span><span>90°</span><span>180°</span></div>
      </div>
      <div class="sblk">
        <div class="sh">
          <span class="sl-name" style="color:var(--gn)">⬆ Shoulder</span>
          <span class="sl-val" style="color:var(--gn)" id="vShoulder">90°</span>
        </div>
        <input type="range" class="srv" id="slShoulder" min="45" max="135" value="90" style="accent-color:var(--gn)" oninput="si('shoulder',this.value)">
        <div class="slims"><span>45°</span><span>90°</span><span>135°</span></div>
      </div>
      <div class="sblk">
        <div class="sh">
          <span class="sl-name" style="color:var(--yw)">↪ Elbow</span>
          <span class="sl-val" style="color:var(--yw)" id="vElbow">45°</span>
        </div>
        <input type="range" class="srv" id="slElbow" min="10" max="120" value="45" style="accent-color:var(--yw)" oninput="si('elbow',this.value)">
        <div class="slims"><span>10°</span><span>45°</span><span>120°</span></div>
      </div>
      <div class="sblk">
        <div class="sh">
          <span class="sl-name" style="color:var(--rd)">✊ Gripper</span>
          <span class="sl-val" style="color:var(--rd)" id="vGripper">30°</span>
        </div>
        <input type="range" class="srv" id="slGripper" min="0" max="40" value="30" style="accent-color:var(--rd)" oninput="si('gripper',this.value)">
        <div class="slims"><span>Close 0°</span><span>30° Open</span></div>
      </div>
      <div style="padding:5px 10px">
        <button class="sv-send" onclick="sendServos()">↑ Send positions</button>
      </div>
    </div>
    <div class="preset-sec">
      <div class="ps-lbl">Presets</div>
      <div class="ps-grid">
        <button class="pb" style="border-color:rgba(0,232,136,.3);color:var(--gn)" onclick="callPreset('pick')">Pick</button>
        <button class="pb" style="border-color:rgba(255,187,0,.3);color:var(--yw)"  onclick="callPreset('place')">Place</button>
        <button class="pb full home" onclick="callHome()">⌂ Home all</button>
        <button class="pb full" style="border-color:rgba(155,114,255,.3);color:var(--pu);margin-top:3px" onclick="openSetHomeModal()">✎ Set home position</button>
      </div>
    </div>
  </div>

  <!-- COL 3: RIGHT -->
  <div class="col-rt">

    <!-- Detections -->
    <div class="panel">
      <div class="ph">
        <div class="ph-l"><div class="ph-ico ico-yw">◉</div>Detected</div>
        <div class="ph-r" id="detBadge">–</div>
      </div>
      <div class="pscroll" id="detList">
        <div class="det-empty">Waiting for stream…</div>
      </div>
    </div>

    <!-- TABS: Recordings / Pick Rules / Training -->
    <div class="panel tabs" style="min-height:0">
      <div class="tab-bar">
        <button class="tab-btn active" onclick="switchTab('rec')">⏺ Recordings</button>
        <button class="tab-btn"        onclick="switchTab('pr')">🎯 Pick rules</button>
        <button class="tab-btn"        onclick="switchTab('tr')">🧬 Training</button>
      </div>

      <!-- ── RECORDINGS TAB ── -->
      <div class="tab-pane active pscroll" id="tab-rec">

        <!-- active recording session -->
        <div id="recSession" style="display:none">
          <div class="rec-session">
            <div class="rec-sess-hdr">
              <span>⏺ RECORDING — <span id="recStepCount">0</span> steps</span>
              <span style="color:var(--tx2);font-size:9px" id="recHoldVal">Hold: 0.5s</span>
            </div>
            <div class="rec-steps-preview" id="recStepsPreview"></div>
            <div class="rec-sess-btns">
              <button class="itb rd" onclick="captureStep()">+ Capture position</button>
              <button class="itb"    onclick="discardLast()">↩ Undo</button>
              <button class="itb gn" onclick="finishRecording()">✓ Save</button>
              <button class="itb"    onclick="cancelRecording()">✕ Cancel</button>
            </div>
            <div style="display:flex;align-items:center;gap:8px;margin-top:6px">
              <span style="font-family:var(--fm);font-size:9px;color:var(--tx3)">HOLD (s)</span>
              <input type="range" style="flex:1;accent-color:var(--cy)" min="0.1" max="5" step="0.1" value="0.5"
                id="recHold" oninput="document.getElementById('recHoldVal').textContent='Hold: '+this.value+'s'">
            </div>
          </div>
        </div>

        <!-- recordings list -->
        <div class="rec-list" id="recList">
          <div class="det-empty">No recordings yet — press ⏺ Record to start</div>
        </div>
      </div>

      <!-- ── PICK RULES TAB ── -->
      <div class="tab-pane pscroll" id="tab-pr" style="padding:6px">
        <div style="font-family:var(--fm);font-size:9px;color:var(--tx3);margin-bottom:6px;line-height:1.6">
          Configure per-object pick-and-place routes.<br>
          When Auto mode detects a trained object, it runs its rule automatically.
        </div>
        <div id="prList"></div>
        <button class="sendbtn gn" onclick="openPrModal(null)">+ New pick rule</button>
      </div>

      <!-- ── TRAINING TAB ── -->
      <div class="tab-pane pscroll" id="tab-tr" style="padding:6px">
        <div class="tf-row">
          <span class="tf-lbl">Name</span>
          <input class="tf-inp" id="tName" placeholder="e.g. red_cube">
        </div>
        <div class="tf-row">
          <span class="tf-lbl">Shape</span>
          <select class="tf-inp" id="tShape">
            <option value="any">Any</option><option value="Circle">Circle</option>
            <option value="Square">Square</option><option value="Rectangle">Rectangle</option>
            <option value="Triangle">Triangle</option><option value="Ellipse">Ellipse</option>
          </select>
        </div>
        <div class="hsvwrap">
          <div class="hsv-lbl">HSV colour range</div>
          <div class="hrow">
            <span class="hl" style="color:#f87171">H</span>
            <input type="range" class="hsl" id="hLo" min="0" max="179" value="0"   oninput="uHSV()" style="accent-color:#f87171">
            <span class="hnum" id="nhLo">0</span><span style="color:var(--tx3);font-size:9px">–</span>
            <input type="range" class="hsl" id="hHi" min="0" max="179" value="179" oninput="uHSV()" style="accent-color:#f87171">
            <span class="hnum" id="nhHi">179</span>
          </div>
          <div class="hrow">
            <span class="hl" style="color:var(--cy)">S</span>
            <input type="range" class="hsl" id="sLo" min="0" max="255" value="80"  oninput="uHSV()" style="accent-color:var(--cy)">
            <span class="hnum" id="nsLo">80</span><span style="color:var(--tx3);font-size:9px">–</span>
            <input type="range" class="hsl" id="sHi" min="0" max="255" value="255" oninput="uHSV()" style="accent-color:var(--cy)">
            <span class="hnum" id="nsShi">255</span>
          </div>
          <div class="hrow">
            <span class="hl" style="color:var(--yw)">V</span>
            <input type="range" class="hsl" id="vLo" min="0" max="255" value="50"  oninput="uHSV()" style="accent-color:var(--yw)">
            <span class="hnum" id="nvLo">50</span><span style="color:var(--tx3);font-size:9px">–</span>
            <input type="range" class="hsl" id="vHi" min="0" max="255" value="255" oninput="uHSV()" style="accent-color:var(--yw)">
            <span class="hnum" id="nvHi">255</span>
          </div>
          <div class="cprev" id="cprev"></div>
          <div class="cname-lbl" id="cname">–</div>
        </div>
        <button class="sendbtn" onclick="trainObj()">⊕ Save trained object</button>
        <div style="font-family:var(--fm);font-size:9px;color:var(--tx3);text-transform:uppercase;
          letter-spacing:.08em;margin:8px 0 4px">Trained objects</div>
        <div id="objList"><div class="det-empty">No objects trained</div></div>
      </div>
    </div>

  </div><!-- /col-rt -->
</div><!-- /main -->
</div><!-- /shell -->

