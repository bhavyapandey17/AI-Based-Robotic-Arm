# ══════════════════════════════════════════════════════════════
#  DATA LAYER  — load / save helpers
# ══════════════════════════════════════════════════════════════
def _load(path, default):
    try:
        if os.path.exists(path):
            with open(path) as f:
                return json.load(f)
    except Exception as e:
        print(f"[DATA] load {path}: {e}")
    return default

def _save(path, data):
    try:
        with open(path, "w") as f:
            json.dump(data, f, indent=2)
    except Exception as e:
        print(f"[DATA] save {path}: {e}")

trained_objects = _load(TRAINING_FILE,   [])
recordings      = _load(RECORDINGS_FILE, [])
pick_rules      = _load(PICK_RULES_FILE, [])

# ══════════════════════════════════════════════════════════════
#  GLOBAL STATE
# ══════════════════════════════════════════════════════════════
edge_enabled      = True
auto_detect       = False
last_detected     = []
frame_lock        = threading.Lock()
playback_status   = {"running": False, "name": "", "step": 0, "total": 0}
record_session    = {"active": False, "steps": [], "pending": None}

# ── Home position ─────────────────────────────────────────
home_position = _load(HOME_POS_FILE, dict(_DEFAULT_HOME))

# ── Auto-mode lockout + detection confirmer ──────────────
_auto_lock        = threading.Lock()
_auto_busy        = False           # True while a cycle is running
_no_rule_prompt   = set()           # objects seen with no recording/rule
last_auto_action  = "IDLE"          # reported in /api/status
_confirm_counts   = {}              # {obj_name: consecutive_frame_count}

# ══════════════════════════════════════════════════════════════
#  COLOUR / SHAPE HELPERS
# ══════════════════════════════════════════════════════════════
def hue_to_name(h_cv):
    d = h_cv * 2
    if d < 15 or d >= 345: return "Red"
    if d < 35:  return "Orange"
    if d < 75:  return "Yellow"
    if d < 160: return "Green"
    if d < 200: return "Cyan"
    if d < 260: return "Blue"
    if d < 290: return "Purple"
    if d < 330: return "Pink"
    return "Red"

def dominant_color_name(mask, hsv_frame):
    px = hsv_frame[mask > 0]
    if not len(px): return "Unknown"
    s, v = np.mean(px[:,1]), np.mean(px[:,2])
    if s < 40:
        return "White" if v > 200 else ("Black" if v < 60 else "Gray")
    return hue_to_name(np.mean(px[:,0]))

def detect_shape(contour):
    peri   = cv2.arcLength(contour, True)
    approx = cv2.approxPolyDP(contour, 0.04 * peri, True)
    n = len(approx)
    if n == 3: return "Triangle"
    if n == 4:
        x, y, w, h = cv2.boundingRect(approx)
        return "Square" if 0.85 <= w/float(h) <= 1.15 else "Rectangle"
    if n >= 6:
        try:
            _, (MA, mi), _ = cv2.fitEllipse(contour)
            return "Circle" if MA / max(mi, 1) < 1.3 else "Ellipse"
        except: return "Circle"
    return "Shape"

# ══════════════════════════════════════════════════════════════
#  SERVO HELPERS  — sequenced gripper delay built in
# ══════════════════════════════════════════════════════════════
def esp_raw(**kw):
    """Send axes directly to ESP32, no sequencing."""
    try:
        r = requests.post(MOVE_URL, json=kw, timeout=2)
        return r.status_code == 200
    except Exception as e:
        print(f"[MOVE] {e}"); return False

def esp_home():
    """Sync home_position to ESP32 then trigger /home."""
    try:
        requests.post(f"http://{ESP32_IP}/set_home", json=home_position, timeout=2)
        r = requests.post(HOME_URL, timeout=2)
        return r.status_code == 200
    except Exception as e:
        print(f"[HOME] {e}"); return False

def _find_recording_by_name(name):
    """Find a recording whose name matches (case-insensitive)."""
    name_l = name.strip().lower()
    return next((r for r in recordings if r["name"].strip().lower() == name_l), None)

def esp_status():
    try:
        r = requests.get(STATUS_URL, timeout=1.5)
        return r.json() if r.status_code == 200 else {}
    except: return {}

def _axes_settled(axes_to_check=("base","shoulder","elbow")):
    """Poll /status until the given axes are within DONE_THRESHOLD of target."""
    for _ in range(120):          # up to 12 s
        st = esp_status()
        if all(
            abs(st.get(a, {}).get("current", 0) - st.get(a, {}).get("target", 0))
            <= DONE_THRESHOLD
            for a in axes_to_check
            if a in st
        ):
            return
        time.sleep(0.1)

def esp_move_seq(base=None, shoulder=None, elbow=None, gripper=None):
    """
    Move arm axes first (base/shoulder/elbow), wait until they settle
    (or GRIPPER_DELAY_SEC, whichever is longer), then move gripper.
    All parameters are optional.
    """
    arm_cmd  = {k: v for k, v in dict(base=base, shoulder=shoulder, elbow=elbow).items() if v is not None}
    grip_cmd = {"gripper": gripper} if gripper is not None else {}

    if arm_cmd:
        esp_raw(**arm_cmd)
        # Wait for physical movement AND minimum delay
        t0 = time.time()
        _axes_settled(list(arm_cmd.keys()))
        elapsed = time.time() - t0
        remaining = GRIPPER_DELAY_SEC - elapsed
        if remaining > 0:
            time.sleep(remaining)

    if grip_cmd:
        esp_raw(**grip_cmd)


# ══════════════════════════════════════════════════════════════
#  RECORDING ENGINE
# ══════════════════════════════════════════════════════════════
def _find_recording(rec_id):
    return next((r for r in recordings if r["id"] == rec_id), None)

def play_recording(rec_id):
    rec = _find_recording(rec_id)
    if not rec or playback_status["running"]:
        return False

    def _run():
        playback_status.update(running=True, name=rec["name"],
                               step=0, total=len(rec["steps"]))
        for i, step in enumerate(rec["steps"]):
            playback_status["step"] = i + 1
            # Honour gripper-delay sequencing per step
            esp_move_seq(
                base     = step.get("base"),
                shoulder = step.get("shoulder"),
                elbow    = step.get("elbow"),
                gripper  = step.get("gripper"),
            )
            hold = step.get("hold", 0.5)
            time.sleep(hold)
        playback_status.update(running=False, name="", step=0, total=0)
        # Always return to home after any recording finishes
        esp_home()

    threading.Thread(target=_run, daemon=True).start()
    return True

# ══════════════════════════════════════════════════════════════
#  PICK-RULE ENGINE
# ══════════════════════════════════════════════════════════════
def execute_pick_rule(obj_name):
    """
    Execute a full pick-and-place cycle SYNCHRONOUSLY.
    Caller is responsible for threading and lockout.
    """
    rule = next((r for r in pick_rules if r["object_name"] == obj_name), None)
    if not rule:
        print(f"[PICK] No rule for '{obj_name}'"); return
    esp_move_seq(base=rule.get("approach_base", 90),
                 shoulder=rule.get("approach_shoulder", 110),
                 elbow=rule.get("approach_elbow", 80))
    esp_move_seq(gripper=rule.get("grip_open", 30))
    time.sleep(0.3)
    esp_move_seq(shoulder=rule.get("grip_shoulder", 120))
    esp_move_seq(gripper=rule.get("grip_close", 0))
    esp_move_seq(shoulder=rule.get("lift_shoulder", 90))
    esp_move_seq(base=rule.get("drop_base", 0))
    time.sleep(rule.get("drop_hold", 0.3))
    esp_move_seq(shoulder=rule.get("drop_shoulder", 110),
                 elbow=rule.get("drop_elbow", 80))
    esp_move_seq(gripper=rule.get("drop_open", 20))
    time.sleep(0.5)
    esp_home()


# ══════════════════════════════════════════════════════════════
#  AUTO-MODE CYCLE ENGINE
#  Logic per detected object:
#   1. Require DETECTION_CONFIRM consecutive frames (debounce).
#   2. If arm busy → skip.
#   3. Look for a recording named after the object (accepted).
#      Look for a recording named "wrong" (for unknowns/rejects).
#   4. Play that recording (blocks further detection via _auto_busy).
#   5. After recording + home return, release lockout.
#   6. Beep: 1× for accepted, 3× for wrong.
# ══════════════════════════════════════════════════════════════
def _auto_cycle(obj_name, accepted):
    """Run in a daemon thread. Owns the _auto_busy lock for its duration."""
    global _auto_busy, last_auto_action
    try:
        if accepted:
            rec = _find_recording_by_name(obj_name)
            if rec:
                last_auto_action = f"PICK:{obj_name}"
                threading.Thread(target=_beep, args=(BEEP_ACCEPT_COUNT,), daemon=True).start()
                play_recording(rec["id"])           # starts its own thread + home return
                # Wait for playback to finish before releasing lockout
                while playback_status["running"]:
                    time.sleep(0.2)
            else:
                # No recording — fall back to pick rule if defined
                rule = next((r for r in pick_rules if r["object_name"] == obj_name), None)
                if rule:
                    last_auto_action = f"RULE:{obj_name}"
                    threading.Thread(target=_beep, args=(BEEP_ACCEPT_COUNT,), daemon=True).start()
                    execute_pick_rule(obj_name)     # synchronous, already homes
                else:
                    _no_rule_prompt.add(obj_name)
                    last_auto_action = f"NO_ACTION:{obj_name}"
        else:
            # Wrong/unknown object
            rec = _find_recording_by_name("wrong")
            last_auto_action = f"REJECT:{obj_name}"
            threading.Thread(target=_beep, args=(BEEP_REJECT_COUNT,), daemon=True).start()
            if rec:
                play_recording(rec["id"])
                while playback_status["running"]:
                    time.sleep(0.2)
            else:
                # No "wrong" recording — just home
                esp_home()
        # Lockout cooldown after action completes
        time.sleep(AUTO_LOCKOUT_S)
    finally:
        with _auto_lock:
            _auto_busy = False
        last_auto_action = "IDLE"


def _auto_trigger(obj_name, accepted):
    """
    Called from process_frame for every confirmed detection.
    Enforces consecutive-frame debounce and lockout.
    """
    global _auto_busy, _confirm_counts
    # Increment consecutive frame counter for this object
    _confirm_counts[obj_name] = _confirm_counts.get(obj_name, 0) + 1
    if _confirm_counts[obj_name] < DETECTION_CONFIRM:
        return   # not confirmed yet
    with _auto_lock:
        if _auto_busy:
            return
        _auto_busy = True
        _confirm_counts.clear()   # reset all counters once a cycle starts
    threading.Thread(target=_auto_cycle, args=(obj_name, accepted), daemon=True).start()

# ══════════════════════════════════════════════════════════════
#  FRAME PROCESSING
# ══════════════════════════════════════════════════════════════
def _suppress_reflections(mask, hsv_frame):
    """
    Remove likely specular reflections from a colour mask.
    Reflections appear as very high-V, very low-S pixels.
    We erode the mask edges (reflections sit on bright edges)
    and exclude pixels where S<30 AND V>220 (near-white glare).
    """
    # Build a glare exclusion mask
    glare = cv2.inRange(hsv_frame,
                        np.array([0,  0, 220], np.uint8),
                        np.array([179,40, 255], np.uint8))
    mask = cv2.bitwise_and(mask, cv2.bitwise_not(glare))
    # Light erosion to trim bright edge halos
    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
    mask   = cv2.erode(mask, kernel, iterations=1)
    mask   = cv2.dilate(mask, kernel, iterations=1)
    return mask


def _in_roi(cy, h):
    """Return True if the centroid's Y position is inside the working ROI."""
    return (h * ROI_TOP) <= cy <= (h * ROI_BOTTOM)

def _solidity(cnt):
    """Solidity = contour area / convex hull area.  Rejects thin/noisy blobs."""
    hull_area = cv2.contourArea(cv2.convexHull(cnt))
    if hull_area == 0:
        return 0.0
    return cv2.contourArea(cnt) / hull_area

def process_frame(frame):
    global last_detected, _confirm_counts
    if frame is None: return None

    output = frame.copy()
    h, w   = frame.shape[:2]
    hsv    = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
    detections    = []
    labeled_masks = []
    seen_names    = set()   # track which objects appeared this frame

    # ── Draw ROI boundary on output (visual feedback) ──
    roi_y_top    = int(h * ROI_TOP)
    roi_y_bottom = int(h * ROI_BOTTOM)
    if ROI_TOP > 0.0 or ROI_BOTTOM < 1.0:
        cv2.line(output, (0, roi_y_top),    (w, roi_y_top),    (60, 60, 200), 1)
        cv2.line(output, (0, roi_y_bottom), (w, roi_y_bottom), (60, 60, 200), 1)
        cv2.putText(output, "ROI", (4, roi_y_top - 4),
                    cv2.FONT_HERSHEY_PLAIN, 0.8, (60, 60, 200), 1, cv2.LINE_AA)

    # ── trained objects ──
    for obj in trained_objects:
        lo = np.array(obj["color_lower"], np.uint8)
        hi = np.array(obj["color_upper"], np.uint8)
        if lo[0] > hi[0]:
            m1 = cv2.inRange(hsv, np.array([lo[0],lo[1],lo[2]]), np.array([179,hi[1],hi[2]]))
            m2 = cv2.inRange(hsv, np.array([0,lo[1],lo[2]]), hi)
            mask = cv2.bitwise_or(m1, m2)
        else:
            mask = cv2.inRange(hsv, lo, hi)
        k    = cv2.getStructuringElement(cv2.MORPH_ELLIPSE,(7,7))
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN,  k)
        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k)
        # ── reflection suppression ──
        mask = _suppress_reflections(mask, hsv)
        cnts, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        for cnt in cnts:
            area = cv2.contourArea(cnt)

            # ── FILTER 1: minimum size — rejects distant/tiny objects ──
            if area < MIN_OBJECT_AREA:
                continue

            # ── FILTER 2: solidity — rejects noisy/fragmented blobs ──
            if _solidity(cnt) < MIN_SOLIDITY:
                continue

            shape = detect_shape(cnt)
            if obj["shape"].lower() not in ("any", shape.lower()): continue

            M = cv2.moments(cnt)
            if M["m00"] == 0: continue
            cx = int(M["m10"]/M["m00"]); cy = int(M["m01"]/M["m00"])

            # ── FILTER 3: ROI — rejects objects outside working zone ──
            if not _in_roi(cy, h):
                continue

            conf  = min(area / 5000 * 100, 99.9)

            # ── FILTER 4: minimum confidence ──
            if conf < MIN_CONFIDENCE:
                continue

            cname = dominant_color_name(mask, hsv)
            # Determine if this is an accepted (has recording/rule) object
            has_rec  = _find_recording_by_name(obj["name"]) is not None
            has_rule = any(r["object_name"] == obj["name"] for r in pick_rules)
            accepted = has_rec or has_rule
            col      = (0,220,80) if accepted else (0,100,255)
            detections.append({"name":obj["name"],"color":cname,"shape":shape,
                                "center":(cx,cy),"confidence":conf,
                                "accepted":accepted})
            labeled_masks.append(mask)
            seen_names.add(obj["name"])
            x2,y2,bw,bh = cv2.boundingRect(cnt)
            cv2.drawContours(output,[cnt],-1,col,2)
            cv2.rectangle(output,(x2,y2),(x2+bw,y2+bh),col,1)
            status_tag = "ACCEPT" if accepted else "REJECT"
            _draw_label(output, obj["name"],
                        f"{cname} {shape}  {conf:.0f}%  [{status_tag}]",
                        (cx,cy), col)
            # ── auto trigger ──
            if auto_detect:
                _auto_trigger(obj["name"], accepted)

    # ── unknowns ──
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    blurred = cv2.GaussianBlur(gray,(7,7),0)
    _, thresh = cv2.threshold(blurred,0,255,cv2.THRESH_BINARY+cv2.THRESH_OTSU)
    combined  = np.zeros((h,w),np.uint8)
    for lm in labeled_masks: combined = cv2.bitwise_or(combined,lm)
    un_cnts,_ = cv2.findContours(thresh,cv2.RETR_EXTERNAL,cv2.CHAIN_APPROX_SIMPLE)
    for cnt in un_cnts:
        area = cv2.contourArea(cnt)
        # ── FILTER 1: size (larger threshold than trained objects) ──
        if area < MIN_UNKNOWN_AREA or area > h*w*0.6: continue
        # ── FILTER 2: solidity ──
        if _solidity(cnt) < MIN_SOLIDITY: continue
        x2,y2,bw,bh = cv2.boundingRect(cnt)
        if combined[y2:y2+bh,x2:x2+bw].mean() > 20: continue
        M = cv2.moments(cnt)
        if M["m00"]==0: continue
        cx=int(M["m10"]/M["m00"]); cy=int(M["m01"]/M["m00"])
        # ── FILTER 3: ROI ──
        if not _in_roi(cy, h): continue
        om = np.zeros((h,w),np.uint8); cv2.drawContours(om,[cnt],-1,255,-1)
        cname = dominant_color_name(om,hsv)
        shape = detect_shape(cnt)
        cv2.drawContours(output,[cnt],-1,(0,80,220),2)
        cv2.rectangle(output,(x2,y2),(x2+bw,y2+bh),(0,80,220),1)
        _draw_label(output,"Unknown",f"{cname} {shape}  [UNKNOWN]",(cx,cy),(0,80,220))
        if auto_detect:
            _auto_trigger("unknown", False)

    # ── edge overlay ──
    if edge_enabled:
        edges = cv2.Canny(gray,40,120)
        output = cv2.addWeighted(output,0.82,cv2.cvtColor(edges,cv2.COLOR_GRAY2BGR),0.18,0)

    # ── NO HUD BAR — clean stream ──
    # Reset confirm counters for objects not seen this frame
    for name in list(_confirm_counts.keys()):
        if name not in seen_names:
            _confirm_counts.pop(name, None)

    with frame_lock:
        last_detected = [
            {"name":d["name"],"color":d["color"],"shape":d["shape"],
             "confidence":round(d["confidence"],1),"accepted":d["accepted"]}
            for d in detections
        ]
    return output

def _draw_label(img, title, subtitle, center, color):
    cx,cy = center
    font  = cv2.FONT_HERSHEY_DUPLEX
    t1w = cv2.getTextSize(title,   font,0.55,1)[0][0]
    t2w = cv2.getTextSize(subtitle,font,0.40,1)[0][0]
    bw,bh = max(t1w,t2w)+16, 36
    x0,y0 = cx-bw//2, cy-58
    ov = img.copy()
    cv2.rectangle(ov,(x0,y0),(x0+bw,y0+bh),(10,10,20),-1)
    cv2.addWeighted(ov,0.6,img,0.4,0,img)
    cv2.putText(img,title,   (x0+8,y0+14),font,0.55,color,          1,cv2.LINE_AA)
    cv2.putText(img,subtitle,(x0+8,y0+28),font,0.40,(200,200,200),1,cv2.LINE_AA)
