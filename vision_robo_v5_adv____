#!/usr/bin/env python3
"""
AI-Based Robotic Arm Vision System  v5
─────────────────────────────────────────────────────────────────
 Features:
  • Motion recordings: record servo keyframes, name/edit/delete,
    playback with per-step delays
  • Pick rules: per-trained-object pick→drop configuration with
    base-angle and drop delay stored to JSON
  • Gripper delay: configurable gap between arm movement and gripper
  • All data stored in DATA_DIR (same folder as this .py file) →
    fully portable, PC-independent
─────────────────────────────────────────────────────────────────
"""

import cv2, numpy as np, requests, json, os, time, threading, sys, struct, wave, io
try:
    import beepy as _beepy
    def _beep(n):
        for _ in range(n):
            _beepy.beep(sound=1)
            time.sleep(0.18)
except ImportError:
    # beepy not installed — fallback to OS beep via print (terminal bell)
    def _beep(n):
        for _ in range(n):
            print("\a", end="", flush=True)
            time.sleep(0.18)
