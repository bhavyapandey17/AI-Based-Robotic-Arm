function syncSlidersToHome(pos) {
  // Update sv{} and all slider elements to match the stored home_position
  const axMap = {base:'slBase',shoulder:'slShoulder',elbow:'slElbow',gripper:'slGripper'};
  const vlMap = {base:'vBase', shoulder:'vShoulder', elbow:'vElbow', gripper:'vGripper'};
  Object.entries(pos).forEach(([ax, val]) => {
    if(ax in axMap) {
      sv[ax] = val;
      const sl = document.getElementById(axMap[ax]);
      const vl = document.getElementById(vlMap[ax]);
      if(sl) sl.value = val;
      if(vl) vl.textContent = val + '°';
    }
  });
}

function initPage() {
  // Fetch home_position from server — sets sliders to the real stored values
  fetch('/api/home_pos').then(r=>r.json()).then(pos=>{
    syncSlidersToHome(pos);
    // Also update _homeVals for the Set Home modal
    _homeVals = {...pos};
  }).catch(()=>{
    // If unreachable, sliders keep their HTML default values (matching _DEFAULT_HOME)
  });
  loadRecordings();
  refreshStatus();
}

initPage();
