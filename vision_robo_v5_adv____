@app.route("/api/recordings/save", methods=["POST"])
def api_recordings_save():
    """Save or update a recording. Body: {id?, name, steps:[{base,shoulder,elbow,gripper,hold}]}"""
    d = request.json or {}
    if not d.get("name") or not isinstance(d.get("steps"), list):
        return jsonify({"error":"name and steps required"}), 400
    rec_id = d.get("id") or f"rec_{int(time.time()*1000)}"
    existing = _find_recording(rec_id)
    rec = {
        "id":      rec_id,
        "name":    d["name"].strip(),
        "steps":   d["steps"],
        "created": existing.get("created", time.strftime("%Y-%m-%d %H:%M:%S")) if existing else time.strftime("%Y-%m-%d %H:%M:%S"),
        "updated": time.strftime("%Y-%m-%d %H:%M:%S"),
    }
    if existing:
        recordings[recordings.index(existing)] = rec
    else:
        recordings.append(rec)
    _save(RECORDINGS_FILE, recordings)
    return jsonify({"status":"saved","id":rec_id,"name":rec["name"],"steps":len(rec["steps"])})

