# ══════════════════════════════════════════════════════════════
#  CONFIGURATION  ← edit these at the top
# ══════════════════════════════════════════════════════════════
# ── ESP32 IP address ───────────────────────────────────────────
# AP mode  (WIFI_MODE="AP"):   always 192.168.4.1  ← connect PC to "RobotArm" WiFi
# STA mode (WIFI_MODE="STA"):  check Serial Monitor for the assigned IP
# APSTA mode:                  use 192.168.4.1 (AP) or the STA IP — both work
ESP32_IP          = "192.168.4.1"   # ← change to STA IP if using STA/APSTA via router
PORT              = 5000

# Gripper sequencing: after non-gripper axes reach target,
# wait this many seconds before moving the gripper.
GRIPPER_DELAY_SEC = 0.5      # ← change here (e.g. 1.5, 3.0 …)

# Smooth-move step size tolerance: consider axis "done" when it
# is within DONE_THRESHOLD degrees of its target.
DONE_THRESHOLD    = 3

# ── Detection accuracy filters ──────────────────────────────
# Minimum contour area (px²) for trained objects.
# 800 was too small — accepted distant/tiny blobs.
# At 640×480 a typical table object is ~4000–20000 px².
# Raise this if distant objects still slip through.
MIN_OBJECT_AREA   = 4000

# Minimum contour area for unknown objects (higher = stricter).
MIN_UNKNOWN_AREA  = 5000

# Minimum confidence % to report a trained-object detection.
# Confidence = area/5000*100, so 4000px²→80%, 3000px²→60%.
MIN_CONFIDENCE    = 60.0

# Minimum solidity (contour area / convex hull area) 0..1.
# Rejects noise, thin edges, partial far-away shapes.
# 0.65 is a good default; raise toward 0.80 for tighter rejection.
MIN_SOLIDITY      = 0.65

# Working-zone ROI: only detect objects inside this vertical band
# of the frame (fraction 0.0=top … 1.0=bottom).
# Distant objects appear near the top; set ROI_TOP > 0 to exclude them.
# Example: ROI_TOP=0.30 ignores the top 30 % of the frame.
# Set ROI_TOP=0.0, ROI_BOTTOM=1.0 to disable (full frame).
ROI_TOP           = 0.30   # ignore top 30 % — where distant objects live
ROI_BOTTOM        = 1.00   # keep everything down to the bottom edge

# ── Auto-mode settings ─────────────────────────────────────
# Seconds between consecutive auto-trigger cycles (lockout).
AUTO_LOCKOUT_S    = 8.0
# Minimum frames an object must be seen consecutively before
# triggering action — reduces false-positive single-frame hits.
DETECTION_CONFIRM = 3

# ── Beep settings ───────────────────────────────────────────
# Uses the PC speaker via 'beepy' if installed, else silent.
# pip install beepy
BEEP_ACCEPT_COUNT = 1    # beeps for accepted/pick object
BEEP_REJECT_COUNT = 3    # beeps for wrong/reject object

# ── Home position (persisted to HOME_POS_FILE) ──────────────
_DEFAULT_HOME = {"base": 90, "shoulder": 90, "elbow": 45, "gripper": 30}

# ── derived URLs ──
STREAM_URL = f"http://{ESP32_IP}/mjpeg"
MOVE_URL   = f"http://{ESP32_IP}/move"
HOME_URL   = f"http://{ESP32_IP}/home"
STATUS_URL = f"http://{ESP32_IP}/status"

# ── portable data directory (same folder as this script) ──
DATA_DIR         = os.path.dirname(os.path.abspath(__file__))
TRAINING_FILE    = os.path.join(DATA_DIR, "trained_objects.json")
RECORDINGS_FILE  = os.path.join(DATA_DIR, "recordings.json")
