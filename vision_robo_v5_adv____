#  STREAM
# ══════════════════════════════════════════════════════════════
def generate_stream():
    session = requests.Session()
    while True:
        try:
            resp = session.get(STREAM_URL, stream=True, timeout=6)
            resp.raise_for_status()
            buf = b""
            for chunk in resp.iter_content(chunk_size=4096):
                if not chunk: continue
                buf += chunk
                a = buf.find(b'\xff\xd8'); b_ = buf.find(b'\xff\xd9')
                if a != -1 and b_ != -1:
                    jpg = buf[a:b_+2]; buf = buf[b_+2:]
                    frame = cv2.imdecode(np.frombuffer(jpg,np.uint8), cv2.IMREAD_COLOR)
                    if frame is None: continue
                    frame = cv2.flip(frame, 0)  # OV3660 vertical flip
                    out = process_frame(frame)
                    if out is None: continue
                    _, enc = cv2.imencode('.jpg', out, [cv2.IMWRITE_JPEG_QUALITY,80])
                    yield b'--frame\r\nContent-Type: image/jpeg\r\n\r\n' + enc.tobytes() + b'\r\n'
        except Exception as e:
            print(f"[STREAM] {e} — retry in 2s"); time.sleep(2)

